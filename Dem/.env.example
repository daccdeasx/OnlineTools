# OnlineTools Backend Configuration
# Copy this file to .env and adjust as needed

# Application
OT_DEBUG=false
OT_APP_NAME=OnlineTools
OT_APP_VERSION=0.1.0

# Server
OT_HOST=0.0.0.0
OT_PORT=8000
OT_WORKERS=2

# CORS (JSON array)
OT_CORS_ORIGINS=["*"]

# Rate Limiting
OT_RATE_LIMIT_ENABLED=true
OT_RATE_LIMIT_REQUESTS=60
OT_RATE_LIMIT_WINDOW=60

# File Upload
OT_MAX_UPLOAD_SIZE_MB=10

# JWT (for future user system)
OT_JWT_SECRET=change-me-in-production
OT_JWT_ALGORITHM=HS256
OT_JWT_EXPIRE_MINUTES=60

# Redis (optional)
OT_REDIS_URL=redis://localhost:6379/0

# CSP
OT_CSP_ENABLED=true
